<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <AuthorizeView>
                    <Authorized Context="authorized">
                        <LayoutView Layout="typeof(MainLayout)">
                            <PageTitle>Access denied</PageTitle>
                            <h1>Access denied</h1>
                            <p class="lede">Your account does not have permission to use that page.</p>
                            <p><a href="/">Return to the dashboard</a></p>
                        </LayoutView>
                    </Authorized>
                    <NotAuthorized Context="anonymous">
                        <RedirectToSignIn />
                    </NotAuthorized>
                </AuthorizeView>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <PageTitle>Page not found</PageTitle>
            <h1>Page not found</h1>
            <p>That address is not a page in this application.</p>
            <p><a href="/">Return to the dashboard</a></p>
        </LayoutView>
    </NotFound>
</Router>
