@inherits LayoutComponentBase
@inject WorkingDatabase Database

<div class="app-shell">
    <header class="site-header">
        <a class="skip-link" href="#main-content">Skip to main content</a>
        <div class="site-brand">
            <p class="site-name">Meridian Test Client</p>
            <p class="site-tagline">Test-client school employment reports</p>
        </div>
        <NavMenu />
    </header>

    <main id="main-content" class="site-main" tabindex="-1">
        @Body
    </main>

    <footer class="site-footer">
        <p>Working database: <span class="database-path">@Database.FilePath</span></p>
    </footer>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a href="" class="dismiss" aria-label="Dismiss error message">Dismiss</a>
</div>
