@inherits LayoutComponentBase

<div class="app-shell">
    <header class="site-header">
        <a class="skip-link" href="#main-content">Skip to main content</a>
        <div class="site-header-inner">
            <a class="site-brand" href="/" aria-label="Meridian Test Client home">
                <span class="site-mark" aria-hidden="true">M</span>
                <span class="site-brand-text">
                    <span class="site-name">Meridian Test Client</span>
                    <span class="site-tagline">School employment reports</span>
                </span>
            </a>
            <NavMenu />
        </div>
    </header>

    <main id="main-content" class="site-main" tabindex="-1">
        @Body
    </main>

    <footer class="site-footer">
        <p>Meridian Test Client · School employment reports</p>
    </footer>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a href="" class="dismiss" aria-label="Dismiss error message">Dismiss</a>
</div>
