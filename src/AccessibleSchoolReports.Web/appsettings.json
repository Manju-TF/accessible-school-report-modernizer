{
  "ConnectionStrings": {
    "SchoolReports": "Data Source=data/schoolreports.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "SeedUserName": "",
    "SeedPassword": "",
    "SeedRole": ""
  },
  "Embeddings": {
    "Provider": "Lexical",
    "Endpoint": "https://api.openai.com/v1/embeddings",
    "Model": "hashed-bow",
    "Dimensions": 256,
    "TimeoutSeconds": 30,
    "MaxRetries": 3,
    "MaxBatchSize": 16,
    "ApiKey": ""
  },
  "LanguageModel": {
    "Provider": "OpenAICompatible",
    "Endpoint": "https://api.openai.com/v1/chat/completions",
    "Model": "gpt-4o-mini",
    "TimeoutSeconds": 60,
    "MaxRetries": 3,
    "Temperature": 0,
    "MaxTokens": 800,
    "ApiKey": ""
  },
  "ReportGeneration": {
    "OutputRoot": "output",
    "ClassYear": "2025",
    "FileName": "summary-report.pdf",
    "DefaultMaxParallelism": 4
  }
}
